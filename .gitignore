# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
.clean_test_venv/

# Environment files and credentials
.env
.env.local
*.pem
*.key

# Streamlit run files and secrets (preserves .streamlit/config.toml)
.streamlit/secrets.toml

# Testing & Coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.cache/

# Operating System Files
.DS_Store
Thumbs.db

# IDEs and local tooling
.idea/
.vscode/
.agents/
.claude/

# Temporary data exports (preserves canonical CSVs)
data/processed/*.parquet
data/processed/*.tmp
